#!/usr/bin/env python3
"""
MissionaryX Checkpoint Verification Tool

Verifies or reports repository checkpoint state.

Usage:
    ./tools/verify-checkpoint                    # Report current state
    ./tools/verify-checkpoint <expected-sha>     # Verify against expected
    ./tools/verify-checkpoint --require-clean <expected-sha>
    ./tools/verify-checkpoint --help             # Show help

Exit codes:
    0: Success (report mode) or checkpoint matches (verify mode)
    1: Checkpoint mismatch or clean-tree requirement failed
    2: Invalid expected SHA, invalid CLI usage, or Git tool/environment error
"""

import argparse
import subprocess
import sys
from pathlib import Path


def get_git_output(args, *, allow_failure=False):
    """Run a read-only Git command, failing explicitly when it is required."""
    try:
        result = subprocess.run(
            ['git'] + args,
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            return result.stdout.strip()
        if allow_failure:
            return None
        detail = result.stderr.strip() or f"git {' '.join(args)} failed"
        print(f"ERROR: {detail}", file=sys.stderr)
        raise SystemExit(2)
    except FileNotFoundError:
        print("ERROR: git command not found", file=sys.stderr)
        raise SystemExit(2)


def get_repository_root():
    """Get the repository root directory."""
    root = get_git_output(['rev-parse', '--show-toplevel'])
    return Path(root)


def get_current_branch():
    """Get the current branch name."""
    branch = get_git_output(['branch', '--show-current'])
    if branch == '':
        # Detached HEAD
        return '(detached HEAD)'
    return branch


def get_current_head():
    """Get the current HEAD commit (full SHA)."""
    return get_git_output(['rev-parse', 'HEAD'])


def get_parent_commit():
    """Get the parent commit (full SHA)."""
    return get_git_output(['rev-parse', 'HEAD^'], allow_failure=True)


def get_tree_status():
    """Get git status output."""
    status = get_git_output(['status', '--porcelain=v1', '--untracked-files=all'])
    if status == '':
        return 'clean'
    else:
        return 'dirty'


def report_state():
    """Report current repository state."""
    root = get_repository_root()
    branch = get_current_branch()
    head = get_current_head()
    parent = get_parent_commit()
    status = get_tree_status()

    print("REPOSITORY STATE")
    print("=" * 70)
    print(f"Repository root: {root}")
    print(f"Current branch:  {branch}")
    print(f"HEAD commit:     {head}")
    if parent:
        print(f"Parent commit:   {parent}")
    print(f"Tree status:     {status}")
    print("=" * 70)

    if status == 'dirty':
        print("\nWARNING: Working tree has uncommitted changes")
        print("Run 'git status' for details")

    return status


def verify_checkpoint(expected_sha, *, require_clean=False):
    """Verify current HEAD matches expected checkpoint."""
    # Validate SHA format (40 hex characters)
    if len(expected_sha) != 40:
        print(f"ERROR: Expected SHA must be 40 characters (got {len(expected_sha)})", file=sys.stderr)
        print("Full SHA-1 hashes are required for checkpoint verification", file=sys.stderr)
        raise SystemExit(2)

    if not all(c in '0123456789abcdef' for c in expected_sha.lower()):
        print("ERROR: Expected SHA contains invalid characters", file=sys.stderr)
        print("SHA must be 40 hexadecimal characters", file=sys.stderr)
        raise SystemExit(2)

    # Get current state
    root = get_repository_root()
    branch = get_current_branch()
    head = get_current_head()
    status = get_tree_status()

    # Normalize SHAs to lowercase for comparison
    expected_sha = expected_sha.lower()
    head = head.lower() if head else None

    # Report state
    print("CHECKPOINT VERIFICATION")
    print("=" * 70)
    print(f"Repository root: {root}")
    print(f"Current branch:  {branch}")
    print(f"Expected SHA:    {expected_sha}")
    print(f"Actual HEAD:     {head}")
    print(f"Tree status:     {status}")
    print("=" * 70)

    # Check match
    if head != expected_sha:
        print("\nCHECKPOINT MISMATCH")
        print(f"Expected: {expected_sha}")
        print(f"Actual:   {head}")
        return False

    print("\nCHECKPOINT MATCH")

    if status == 'dirty':
        print("\nWARNING: Checkpoint matches but tree has uncommitted changes")
        print("Run 'git status' for details")
        if require_clean:
            print("\nCLEAN TREE REQUIRED")
            return False

    return True


def show_help():
    """Show help message."""
    print(__doc__)


def parse_arguments(argv):
    """Parse checkpoint and cleanliness requirements."""
    parser = argparse.ArgumentParser(
        description="Report or verify a MissionaryX Git checkpoint.",
    )
    parser.add_argument(
        "--require-clean",
        action="store_true",
        help="fail if tracked or untracked working-tree changes exist",
    )
    parser.add_argument("expected_sha", nargs="?", help="expected full 40-character SHA")
    return parser.parse_args(argv)


def main():
    """Main entry point."""
    args = parse_arguments(sys.argv[1:])

    if args.expected_sha is None:
        status = report_state()
        if args.require_clean and status != "clean":
            print("\nCLEAN TREE REQUIRED")
            raise SystemExit(1)
        raise SystemExit(0)

    if verify_checkpoint(args.expected_sha, require_clean=args.require_clean):
        raise SystemExit(0)
    raise SystemExit(1)


if __name__ == '__main__':
    main()
