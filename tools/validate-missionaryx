#!/usr/bin/env python3
"""
MissionaryX Validation Tool

Runs deterministic validation with comprehensive reporting.

Usage:
    ./tools/validate-missionaryx                 # Full validation (default)
    ./tools/validate-missionaryx --full          # Full validation
    ./tools/validate-missionaryx --quick         # Quick validation
    ./tools/validate-missionaryx --quick --base <full-sha>
    ./tools/validate-missionaryx --help          # Show help

Exit codes:
    0: All validations passed
    1: One or more validations failed
    2: Invalid usage or environment error
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path


QUICK_TESTS = (
    "tests/test_mission_runtime_foundation.py",
    "tests/test_authority_foundation.py",
    "tests/test_access_credential_broker_foundation.py",
    "tests/test_durable_effect_store.py",
    "tests/test_effect_gateway_foundation.py",
)

KNOWN_DESELECTIONS = (
    "tests/test_llamacpp_adapter.py::test_timeout_returns_error_response",
)

FULL_SHA_PATTERN = re.compile(r"^[0-9a-fA-F]{40}$")


def run_command(args, description, cwd=None, env=None):
    """Run command and return success status and output."""
    print(f"\n{'=' * 70}")
    print(f"Running: {description}")
    print(f"Command: {' '.join(args)}")
    print(f"{'=' * 70}")

    start_time = time.time()

    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            cwd=cwd,
            env=env
        )
        elapsed = time.time() - start_time

        print(result.stdout)
        if result.stderr:
            print(result.stderr, file=sys.stderr)

        print(f"\nElapsed: {elapsed:.2f}s")
        print(f"Exit code: {result.returncode}")

        return result.returncode == 0, result.stdout, result.stderr

    except FileNotFoundError as e:
        print(f"ERROR: Command not found: {e}", file=sys.stderr)
        return False, "", str(e)
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return False, "", str(e)


def get_repository_root():
    """Get repository root."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        detail = result.stderr.strip() or "not in a Git repository"
        print(f"ERROR: Cannot establish repository root: {detail}", file=sys.stderr)
        raise SystemExit(2)
    return Path(result.stdout.strip())


def get_python_path(root):
    """Get Python path, preferring .venv if it exists."""
    venv_python = root / '.venv' / 'bin' / 'python'

    if venv_python.exists():
        return str(venv_python)
    else:
        return 'python3'


def get_pytest_path(root):
    """Get pytest path, preferring .venv if it exists."""
    venv_pytest = root / '.venv' / 'bin' / 'pytest'

    if venv_pytest.exists():
        return str(venv_pytest)
    else:
        return 'pytest'


def print_header(title):
    """Print section header."""
    print("\n" + "=" * 70)
    print(f"  {title}")
    print("=" * 70)


def report_environment(root):
    """Report validation environment."""
    print_header("VALIDATION ENVIRONMENT")

    python_path = get_python_path(root)

    # Python version
    all_passed, _, _ = run_command(
        [python_path, '--version'],
        'Python version',
        cwd=root
    )

    # Repository path
    print(f"\nRepository: {root}")

    for args, label in (
        (["git", "branch", "--show-current"], "Git branch"),
        (["git", "rev-parse", "HEAD"], "Git HEAD"),
        (["git", "status", "--porcelain=v1", "--untracked-files=all"], "Git status"),
    ):
        success, _, _ = run_command(args, label, cwd=root)
        all_passed = success and all_passed

    return all_passed


def validate_base(root, base):
    """Validate an explicit full-SHA milestone base and its ancestry."""
    if base is None:
        return True
    if FULL_SHA_PATTERN.fullmatch(base) is None:
        print("ERROR: --base requires a full 40-character hexadecimal SHA", file=sys.stderr)
        return False

    exists, _, _ = run_command(
        ["git", "cat-file", "-e", f"{base}^{{commit}}"],
        "Verify milestone base is a commit",
        cwd=root,
    )
    if not exists:
        return False

    ancestor, _, _ = run_command(
        ["git", "merge-base", "--is-ancestor", base, "HEAD"],
        "Verify milestone base is an ancestor of HEAD",
        cwd=root,
    )
    return ancestor


def run_git_diff_checks(root, base=None):
    """Check unstaged, staged, and optional committed milestone diffs."""
    print_header("GIT DIFF CHECK")

    all_passed, _, _ = run_command(
        ["git", "diff", "--check"],
        "Check unstaged working-tree diff",
        cwd=root,
    )
    staged, _, _ = run_command(
        ["git", "diff", "--cached", "--check"],
        "Check staged working-tree diff",
        cwd=root,
    )
    all_passed = staged and all_passed

    if base is not None:
        range_success, _, _ = run_command(
            ["git", "diff", "--check", f"{base}..HEAD"],
            "Check committed milestone range",
            cwd=root,
        )
        all_passed = range_success and all_passed

    return all_passed


def run_compile_check(root):
    """Compile Python with bytecode redirected outside the worktree."""
    print_header("PYTHON COMPILE CHECK")

    python_path = get_python_path(root)
    with tempfile.TemporaryDirectory(prefix="missionaryx-bytecode-") as cache_dir:
        env = os.environ.copy()
        env.pop("PYTHONDONTWRITEBYTECODE", None)
        env["PYTHONPYCACHEPREFIX"] = cache_dir
        success, _, _ = run_command(
            [python_path, "-m", "compileall", "-q", "-f", "."],
            "Compile all Python files with external bytecode cache",
            cwd=root,
            env=env,
        )
    return success


def run_quick_validation(root):
    """Run quick validation tests."""
    print_header("QUICK VALIDATION")

    pytest_path = get_pytest_path(root)
    missing_tests = [path for path in QUICK_TESTS if not (root / path).is_file()]
    if missing_tests:
        print("ERROR: Required quick-validation test files are missing:", file=sys.stderr)
        for path in missing_tests:
            print(f"  - {path}", file=sys.stderr)
        return False

    # Set environment to prevent bytecode generation
    env = os.environ.copy()
    env['PYTHONDONTWRITEBYTECODE'] = '1'

    success, stdout, _ = run_command(
        [pytest_path, '-p', 'no:cacheprovider', '-q', *QUICK_TESTS],
        'Quick validation tests',
        cwd=root,
        env=env
    )

    # Parse pytest output for counts
    print("\nTest Results Summary:")
    for line in stdout.split('\n'):
        if 'passed' in line or 'failed' in line or 'error' in line:
            print(f"  {line}")

    return success


def run_full_validation(root):
    """Run full validation with known deselections."""
    print_header("FULL VALIDATION")

    pytest_path = get_pytest_path(root)

    # Set environment to prevent bytecode generation
    env = os.environ.copy()
    env['PYTHONDONTWRITEBYTECODE'] = '1'

    deselections = [f"--deselect={node_id}" for node_id in KNOWN_DESELECTIONS]

    success, stdout, _ = run_command(
        [pytest_path, '-p', 'no:cacheprovider', '-q'] + deselections,
        'Full test suite with documented deselections',
        cwd=root,
        env=env
    )

    # Parse pytest output for counts
    print("\nTest Results Summary:")
    for line in stdout.split('\n'):
        if 'passed' in line or 'failed' in line or 'error' in line or 'deselected' in line:
            print(f"  {line}")

    print("\nKnown Deselections:")
    for node_id in KNOWN_DESELECTIONS:
        print(f"  - {node_id}")
    print("    Reason: Inherited flaky timeout test")

    return success


def show_help():
    """Show help message."""
    print(__doc__)


def parse_arguments(argv):
    """Parse validation mode and optional exact milestone base."""
    parser = argparse.ArgumentParser(
        description="Run deterministic MissionaryX validation.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--quick", action="store_const", const="quick", dest="mode")
    mode.add_argument("--full", action="store_const", const="full", dest="mode")
    parser.add_argument(
        "--base",
        metavar="FULL_SHA",
        help="check the committed milestone range FULL_SHA..HEAD",
    )
    parser.set_defaults(mode="full")
    return parser.parse_args(argv)


def main():
    """Main entry point."""
    args = parse_arguments(sys.argv[1:])
    root = get_repository_root()

    if args.base is not None and not validate_base(root, args.base):
        raise SystemExit(2)

    if not report_environment(root):
        print("ERROR: Could not establish the required validation environment", file=sys.stderr)
        raise SystemExit(1)

    # Track overall success
    all_passed = True

    # Working-tree integrity always applies; milestone range applies when explicit.
    all_passed = run_git_diff_checks(root, args.base) and all_passed

    # Run validations
    if args.mode == 'quick':
        print_header("QUICK VALIDATION MODE")
        all_passed = run_quick_validation(root) and all_passed
    else:  # full
        print_header("FULL VALIDATION MODE")

        # Compile check
        all_passed = run_compile_check(root) and all_passed

        # Full test suite
        all_passed = run_full_validation(root) and all_passed

    # Final summary
    print_header("VALIDATION SUMMARY")

    if all_passed:
        print("\n✓ ALL VALIDATIONS PASSED")
        sys.exit(0)
    else:
        print("\n✗ ONE OR MORE VALIDATIONS FAILED")
        print("Review output above for details")
        sys.exit(1)


if __name__ == '__main__':
    main()
