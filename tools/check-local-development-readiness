EXPECTED_MODEL_SHA256 = (
    "74a4da8c9fdbcd15bd1f6d01d621410d31c6fc00986f5eb687824e7b93d7a9db"
)
EXPECTED_MODEL_RELATIVE_PATH = Path(
    "local-ai/models/qwen2.5-0.5b-instruct/"
    "qwen2.5-0.5b-instruct-q4_k_m.gguf"
)
EXPECTED_LLAMA_CPP_RELATIVE_PATH = Path("local-ai/llama.cpp")
EXPECTED_WHEELHOUSE_NAME = "missionaryx-offline-wheelhouse"
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")
COMMIT_PATTERN = re.compile(r"^[0-9a-f]{40}$")
PIN_PATTERN = re.compile(r"^([A-Za-z0-9][A-Za-z0-9_.-]*)==([^\s;]+)$")
MANIFEST_PATTERN = re.compile(r"^([0-9a-f]{64}) ([ *])(.+)$")
MINIMUM_PYTHON = (3, 11)
MAXIMUM_DETAIL_LENGTH = 600
MAXIMUM_LIVE_RESPONSE_BYTES = 1 << 20


@dataclass(frozen=True)
class ReadinessPaths:
    repository: Path
    python: Path
    wheelhouse: Path
    requirements: Path
    llama_cpp_source: Path
    llama_server: Path
    model: Path


@dataclass(frozen=True)
class CheckResult:
    name: str
    passed: bool
    detail: str


class Reporter:
    def __init__(self, output: TextIO):
        self.output = output
        self.results: list[CheckResult] = []

    def record(self, name: str, passed: bool, detail: str) -> bool:
        normalized = _one_line(detail)
        self.results.append(CheckResult(name, passed, normalized))
        status = "PASS" if passed else "FAIL"
        suffix = f" {normalized}" if normalized else ""
        print(f"{status} {name}{suffix}", file=self.output)
        return passed

    def skip(self, name: str, detail: str) -> None:
        print(f"SKIP {name} {_one_line(detail)}", file=self.output)


def _one_line(value: Any) -> str:
    text = " ".join(str(value).split())
    if len(text) > MAXIMUM_DETAIL_LENGTH:
        return text[: MAXIMUM_DETAIL_LENGTH - 3] + "..."
    return text


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _regular_file(path: Path) -> bool:
    try:
        return not path.is_symlink() and stat.S_ISREG(path.stat().st_mode)
    except OSError:
        return False


def _run(
    command: Sequence[str],
    *,
    cwd: Path | None = None,
    environment: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    normalized = list(command)
    try:
        return subprocess.run(
            normalized,
            cwd=cwd,
            env=None if environment is None else dict(environment),
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        return subprocess.CompletedProcess(
            normalized,
            127,
            stdout="",
            stderr=f"{type(exc).__name__}: command could not be executed",
        )


def _default_repository() -> Path:
    result = _run(["git", "rev-parse", "--show-toplevel"], cwd=Path.cwd())
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip())
    return Path.cwd()


