RAGHUB_ENV=development
RAGHUB_SECRET_KEY=replace-with-a-random-secret
RAGHUB_DEMO_READ_ONLY=false
RAGHUB_REQUEST_TIMEOUT_SECONDS=20
RAGHUB_MAX_REQUEST_BYTES=1048576
RAGHUB_RATE_LIMIT_PER_MINUTE=120
RAGHUB_LIFECYCLE_DB=data/intelligence_lifecycle.db
RAGHUB_SITUATION_ROOM_DB=data/situation_room.db
RAGHUB_RETRIEVAL_PROVIDERS=pgvector,wikipedia
# Optional comma-separated additions; English is always enabled.
RAGHUB_GDELT_LANGUAGES=

# Private Windows compute worker. Generate a distinct random token; never reuse
# a provider or database credential.
RAGHUB_COMPUTE_DATABASE=data/compute_jobs.db
RAGHUB_WORKER_TOKEN=

# SIP v1.0 Personal Edition. Localhost is the safe default.
SIP_MODE=live
SIP_HOST=127.0.0.1
SIP_PORT=5000
SIP_PERSONAL_DATABASE=data/sip_personal.db
SIP_MODEL_PATH=data/models/moneyline-v1.json
# NBA pregame full-game moneyline is the flagship SIP v1 scope.
ODDS_FEED_ENABLED=true
# Supported: sportsgameodds or the_odds_api.
ODDS_PROVIDER=sportsgameodds
ODDS_API_KEY=
ODDS_BASE_URL=https://api.sportsgameodds.com/v2
ODDS_REGIONS=us
ODDS_SPORTS=basketball_nba
ODDS_MARKETS=h2h
ODDS_REQUEST_TIMEOUT_SECONDS=15
ODDS_MAX_EVENTS_PER_REQUEST=10
ODDS_MAX_QUOTE_AGE_SECONDS=600
ODDS_REFRESH_MINUTES=10

# Central qualification thresholds.
MIN_MODEL_EDGE=0.03
MIN_DATA_QUALITY=0.75
MIN_COMPLETE_BOOKS=2
FORECAST_MAX_AGE_SECONDS=3600

# Optional RAG providers. Leave unset when the related provider is disabled.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_SERVICE_URL=

# Optional PostgreSQL/pgvector configuration.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Situation Room economic and public-policy feeds.
FRED_API_KEY=
API_DATA_GOV_KEY=
# Backward-compatible alias; API_DATA_GOV_KEY is preferred for Congress.gov.
CONGRESS_API_KEY=
